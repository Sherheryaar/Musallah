.env
node_modules/
.expo/
dist/
web-build/
*.log
.DS_Store

# Local build outputs. A release APK is ~60 MB of generated binary; it comes
# from `eas build` and belongs on a release, not in git history.
*.apk
*.aab
scripts/.overpass-cache.json
app-example/
expo-env.d.ts

# Generated audit/harvest output — reproducible by re-running the scripts
# in scripts/, and too large/churny to keep in history.
coord-report*.md
place-confidence-report.md
address-issues.json
close-pairs.json
london-subset.json
jummah-candidates.*
mawaqit-matches.json
mawaqit-checkpoint.json
mawaqit-jummah-report.md
apply-jummah-times.sql
apply-mawaqit-jummah.sql
timetable-discovery.json
timetable-discovery-report.md

# Agent skills are vendored tooling, not app code: 12 MB of markdown, CSV data
# and font binaries. skills-lock.json IS committed — it pins the versions, and
# `npx skills experimental_install` restores this directory from it.
.claude/skills/
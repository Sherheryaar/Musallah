{
  "name": "masjid-locator",
  "version": "0.1.4",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "tunnel": "expo start --tunnel",
    "build:places": "node scripts/csv-to-places.mjs",
    "sync:places": "node scripts/sync-places.mjs",
    "verify:places": "node scripts/verify-places.mjs",
    "refresh:times": "node scripts/refresh-times.mjs --dry-run",
    "discover:timetables": "node scripts/discover-timetables.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.110.8",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.0",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.0",
    "expo-location": "~19.0.0",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.0",
    "expo-sensors": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.0",
    "vitest": "^4.1.10"
  },
  "private": true
}

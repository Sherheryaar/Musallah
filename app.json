{
  "expo": {
    "name": "Masjid Locator",
    "slug": "masjid-locator",
    "version": "0.1.4",
    "scheme": "masjidlocator",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sheheryaarbaber.masjidlocator"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.sheheryaarbaber.masjidlocator"
    },
    "web": {
      "output": "single",
      "favicon": "./public/icon-192.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "We use your location only to show the nearest places to pray. It never leaves your device."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F9F8F7",
          "dark": {
            "backgroundColor": "#141312"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "56355049-a6df-42d8-ac99-d5bfd0bbc2ad"
      }
    },
    "owner": "shezzi"
  }
}

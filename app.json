{
  "expo": {
    "name": "Musallah",
    "slug": "masjid-locator",
    "version": "0.1.8",
    "scheme": "masjidlocator",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sheheryaarbaber.masjidlocator"
    },
    "androidNavigationBar": {
      "enforceContrast": false
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.sheheryaarbaber.masjidlocator",
      "permissions": ["android.permission.SCHEDULE_EXACT_ALARM"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-mono.png",
        "backgroundColor": "#2E7D57"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2E7D57"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "We use your location only to show the nearest places to pray. It never leaves your device."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F6F5F1",
          "dark": {
            "backgroundColor": "#121211"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "56355049-a6df-42d8-ac99-d5bfd0bbc2ad"
      }
    },
    "owner": "shezzi"
  }
}
